  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cdf8aa70679ec44da34306cbf6f69aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OrganData
  organName: "\xDAtero"
  description: "O \xFAtero \xE9 um \xF3rg\xE3o muscular localizado na pelve, respons\xE1vel
    por receber e nutrir o embri\xE3o durante a gesta\xE7\xE3o. Suas paredes internas
    passam por mudan\xE7as ao longo do ciclo menstrual, preparando-se mensalmente
    para uma poss\xEDvel gravidez. Quando n\xE3o ocorre fecunda\xE7\xE3o, esse revestimento
    \xE9 eliminado na menstrua\xE7\xE3o."
